POSTGRES_DB=pricestockbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Globalny nadawca alertow email. Uzytkownik w aplikacji wpisuje tylko adres odbiorcy.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=PriceStockBot
EMAIL_ENABLE_SSL=true

# Install Chromium into the API and worker images and enable rendered price checks.
PLAYWRIGHT_ENABLED=false

# Use the same VAPID key pair in the API and worker.
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
