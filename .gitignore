.env
.env.*
!.env.example
*.local
*.secret
*.secrets
secrets.json
appsettings.Development.json
appsettings.Local.json

# Logs and runtime output
*.log
logs/
*.pid
*.seed
*.pid.lock
.codex-*.log
.codex-dashboard-*.log

# Node / React / Vite
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
.turbo/
.next/
coverage/
**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Browser extension build artifacts
*.crx
*.pem
*.zip
*.xpi

# .NET / C#
bin/
obj/
**/bin/
**/obj/
TestResults/
**/TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.nupkg
*.snupkg
*.coverage
*.coveragexml
coverage.opencover.xml

# IDEs and editors
.vs/
.vscode/
.idea/
*.swp
*.swo
*.swn

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Docker and local data
docker-data/
postgres-data/
pgdata/
*.db
*.sqlite
*.sqlite3

# Playwright / browser automation
playwright-report/
test-results/
blob-report/
.playwright/

# Temporary files
tmp/
temp/
*.tmp
*.temp
